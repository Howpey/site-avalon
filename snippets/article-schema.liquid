{%- comment -%}
  BlogPosting + BreadcrumbList + FAQPage JSON-LD for an article page.

  Usage: {% render 'article-schema', article: article, blog: blog %}
{%- endcomment -%}
{%- assign article_url = shop.url | append: article.url -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": {{ article_url | append: '#article' | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ article_url | json }}
    },
    "url": {{ article_url | json }},
    "headline": {{ article.title | json }},
    "description": {{ article.excerpt | strip_html | strip | default: page_description | json }},
    "articleBody": {{ article.content | strip_html | json }},
    "inLanguage": {{ request.locale.iso_code | json }},
    {%- if article.image %}
      "image": [
        {{ article | image_url: width: 1920 | prepend: 'https:' | json }}
      ],
    {%- endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
    "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
    "author": {
      "@type": {% if article.author == shop.name %}"Organization"{% else %}"Person"{% endif %},
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      "@id": {{ shop.url | append: '/#organization' | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
      {%- if settings.logo != blank -%}
        ,
        "logo": {
          "@type": "ImageObject",
          "url": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
        }
      {%- endif %}
    }
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ shop.url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} },
      { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ article_url | json }} }
    ]
  }
</script>
{%- render 'faq-schema', html: article.content -%}
