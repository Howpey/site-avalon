{%- comment -%}
  Renders a header logo component

  Usage:
  {% render 'header-logo' %}
{%- endcomment -%}

{%- liquid
  assign logo = settings.logo
  assign logo_mobile = settings.logo_mobile | default: logo

  assign white_logo = settings.white_logo
  assign white_logo_mobile = settings.white_logo_mobile | default: white_logo

  # Aspect ratios default to 1 so divided_by não quebra
  assign logo_ar = logo.aspect_ratio | default: 1.0
  assign logo_mobile_ar = logo_mobile.aspect_ratio | default: 1.0
  assign white_logo_ar = white_logo.aspect_ratio | default: 1.0
  assign white_logo_mobile_ar = white_logo_mobile.aspect_ratio | default: 1.0

  # logo_width é a única setting declarada no schema atual e a única
  # que o slider do editor escreve. Schema range 40-400 desktop, 40-200 mobile.
  assign lw = settings.logo_width | default: 100 | at_least: 1 | at_most: 5760
  assign lwm = settings.logo_width_mobile | default: 100 | at_least: 1 | at_most: 5760

  # Altura deriva do aspect ratio
  assign lh = lw | divided_by: logo_ar | round | at_least: 1 | at_most: 5760
  assign lhm = lwm | divided_by: logo_mobile_ar | round | at_least: 1 | at_most: 5760

  # Largura da fonte (retina 2x)
  assign src_w = lw | times: 2 | at_least: 1 | at_most: 5760
  assign src_wm = lwm | times: 2 | at_least: 1 | at_most: 5760
-%}

{%- if template == 'index' -%}
  <h1 class="header__logo flex justify-center z-1" itemscope itemtype="http://schema.org/Organization">
    <span class="sr-only">{{ shop.name }}</span>
{%- else -%}
  <div class="header__logo flex justify-center z-1" itemscope itemtype="http://schema.org/Organization">
{%- endif -%}

  {%- if logo != blank -%}
    <a
      href="{{ routes.root_url }}"
      itemprop="url"
      class="header__logo-link{% if white_logo %} has-white-logo{% endif %} flex items-center relative"
    >
      <span class="sr-only">{{ shop.name }}</span>

      {%- comment -%} Desktop logo {%- endcomment -%}
      {%- capture sizes -%}{{ lw }}px{%- endcapture -%}
      {%- capture widths -%}{{ lw }}, {{ src_w }}{%- endcapture -%}
      {%- capture style -%}max-height: {{ lh }}px;max-width: {{ lw }}px;height: auto;width: auto;{%- endcapture -%}

      {%- comment -%} Mobile logo {%- endcomment -%}
      {%- capture mobile_sizes -%}{{ lwm }}px{%- endcapture -%}
      {%- capture mobile_widths -%}{{ lwm }}, {{ src_wm }}{%- endcapture -%}
      {%- capture mobile_style -%}max-height: {{ lhm }}px;max-width: {{ lwm }}px;height: auto;width: auto;{%- endcapture -%}

      {%- liquid
        echo logo | image_url: width: src_w | image_tag: alt: shop.name, loading: 'lazy', widths: widths, sizes: sizes, style: style, preload: true, itemprop: 'logo', is: 'lazy-image', class: 'logo hidden md:block'
        echo logo_mobile | image_url: width: src_wm | image_tag: alt: shop.name, loading: 'lazy', widths: mobile_widths, sizes: mobile_sizes, style: mobile_style, preload: true, itemprop: 'logo', is: 'lazy-image', class: 'logo md:hidden'
      -%}

      {%- if white_logo -%}
        {%- assign wlw = lh | times: white_logo_ar | round | at_least: 1 | at_most: 5760 -%}
        {%- assign wlwm = lhm | times: white_logo_mobile_ar | round | at_least: 1 | at_most: 5760 -%}
        {%- comment -%} Desktop logo {%- endcomment -%}
        {%- capture sizes -%}{{ wlw }}px{%- endcapture -%}
        {%- capture widths -%}{{ wlw }}, {{ wlw | times: 2 | at_most: 5760 }}{%- endcapture -%}
        {%- capture style -%}max-height: {{ lh }}px;max-width: {{ wlw }}px;height: auto;width: auto;{%- endcapture -%}

        {%- comment -%} Mobile logo {%- endcomment -%}
        {%- capture mobile_sizes -%}{{ wlwm }}px{%- endcapture -%}
        {%- capture mobile_widths -%}{{ wlwm }}, {{ wlwm | times: 2 | at_most: 5760 }}{%- endcapture -%}
        {%- capture mobile_style -%}max-height: {{ lhm }}px;max-width: {{ wlwm }}px;height: auto;width: auto;{%- endcapture -%}

        {%- liquid
          echo white_logo | image_url: width: src_w | image_tag: alt: shop.name, loading: 'lazy', widths: widths, sizes: sizes, style: style, preload: true, itemprop: 'logo', is: 'lazy-image', class: 'white-logo hidden md:block absolute'
          echo white_logo_mobile | image_url: width: src_wm | image_tag: alt: shop.name, loading: 'lazy', widths: mobile_widths, sizes: mobile_sizes, style: mobile_style, preload: true, itemprop: 'logo', is: 'lazy-image', class: 'white-logo md:hidden absolute'
        -%}
      {%- endif -%}
    </a>
  {%- else -%}
    <a href="{{ routes.root_url }}" itemprop="url" class="h3">{{ shop.name }}</a>
  {%- endif -%}

{%- if template == 'index' -%}
  </h1>
{%- else -%}
  </div>
{%- endif -%}
